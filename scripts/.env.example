# ─────────────────────────────────────────────────────────────────────────────
# Veil Bridge — the DEPLOY SCRIPTS' environment.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# This file holds PRIVATE KEYS. It is gitignored; keep it that way, and use
# throwaway testnet accounts.
#
# The app has its own, separate environment: ../frontend/.env.example. Nothing
# here is ever read by the browser.
#
# Every script below needs the same two or three of these:
#
#   deploy-faucet.js   EVM_RPC_URL, EVM_PRIVATE_KEY
#   deploy-evm.js      EVM_RPC_URL, EVM_PRIVATE_KEY
#   deploy-starknet.js STARKNET_RPC_URL, STARKNET_ACCOUNT_ADDRESS,
#                      STARKNET_PRIVATE_KEY
#   wire.js            all five (it touches both chains)
#   bridge.js          all five
#   set-addresses.js   none — it only writes the deployment file
# ─────────────────────────────────────────────────────────────────────────────

# ── EVM side (Ethereum Sepolia) ──────────────────────────────────────────────
# The account that deploys the lockbox and the faucet assets, and that becomes
# their owner and agent. Needs Sepolia ETH.
EVM_RPC_URL=https://sepolia.infura.io/v3/<key>
EVM_PRIVATE_KEY=0x<64 hex chars>

# ── Starknet side ────────────────────────────────────────────────────────────
# Must serve RPC spec 0.8+ -- starknet.js v10 cannot talk to an older node, and
# live Sepolia is on 0.10.x. Verify with:
#   curl -s -X POST $STARKNET_RPC_URL -H 'content-type: application/json' \
#     -d '{"jsonrpc":"2.0","id":1,"method":"starknet_specVersion","params":[]}'
STARKNET_RPC_URL=https://starknet-sepolia.drpc.org

# A DEPLOYED account contract and its key. Not an EOA: Starknet has none, so a
# freshly generated keypair does not work until its account is deployed and
# funded with STRK.
STARKNET_ACCOUNT_ADDRESS=0x<account contract address>
STARKNET_PRIVATE_KEY=0x<key>

# ── Optional ─────────────────────────────────────────────────────────────────
# Only if your environment has no working global fetch (some sandboxes, some CI
# images). Routes RPC through Node's http module instead. Harmless otherwise.
# STARKNET_HTTP_FETCH=1
