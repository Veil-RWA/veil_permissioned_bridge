{
  "name": "veil-bridge-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bridge permissioned ERC-3643 assets between EVM chains and Starknet.",
  "scripts": {
    "dev": "node scripts/sync-sdk.mjs --if-present && node scripts/pull-deployment.mjs && vite",
    "build": "node scripts/sync-sdk.mjs --if-present && node scripts/pull-deployment.mjs && node scripts/typecheck.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "sync-sdk": "node scripts/sync-sdk.mjs",
    "test": "node src/notes.test.mjs",
    "demo": "VITE_DEPLOYMENT=demo.json npm run dev",
    "build:demo": "VITE_DEPLOYMENT=demo.json npm run build"
  },
  "dependencies": {
    "@starknet-io/get-starknet": "^4.0.8",
    "@vercel/analytics": "^2.0.1",
    "ethers": "^6.13.0",
    "starknet": "^10.0.2",
    "veil-sdk": "file:./vendor/veil-sdk"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
