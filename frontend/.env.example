# Which deployment file under ../deployments to load (default sepolia pair)
VITE_DEPLOYMENT=ethereum-sepolia__starknet-sepolia.json

# Read-only RPC used for quotes and balances before a wallet connects
VITE_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_STARKNET_RPC_URL=https://starknet-sepolia.drpc.org
